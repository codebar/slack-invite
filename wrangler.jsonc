{
  "name": "slack-invite",
  "main": "src/index.js",
  "compatibility_date": "2025-10-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // triggers.crons (daily health check) is added at cutover — before then the
  // real Slack token is not installed and the check would only raise false alerts.
}
